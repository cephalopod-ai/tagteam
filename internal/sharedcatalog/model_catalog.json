{
  "schema_version": 1,
  "contract_version": "0.5.0",
  "updated": "2026-09-07",
  "source_repo": "e3742526/control-hooks",
  "source_path": "shared/model-catalog/model_catalog.json",
  "notes": "Canonical, language-neutral roster of the coding-agent adapters and model IDs the fleet maintains. Consumers vendor this file byte-identically (see shared/README.md). Entries are maintained labels, not entitlement claims: a listed model is not proof the logged-in account can reach it, and live provider discovery wins wherever an adapter exposes one. context_window and max_output carry the provider contract limit and are kept equal to control_hooks.dispatch.catalog; they are NOT routing priors — a consumer that deliberately budgets a role below the contract limit (tagteam's agent roster, for one) keeps that number in its own config.",
  "adapters": [
    {
      "id": "codex",
      "display_name": "Codex CLI",
      "kind": "cli",
      "binary": "codex",
      "family": "openai",
      "roles": ["editor", "reviewer", "scout"],
      "headless": "codex exec -s <sandbox> -m <model> -",
      "prompt_transport": "stdin",
      "discovery": null
    },
    {
      "id": "codex-oss",
      "display_name": "Codex CLI (open-weights)",
      "kind": "cli",
      "binary": "codex",
      "family": "local",
      "roles": ["editor", "reviewer", "scout"],
      "headless": "codex exec --oss -s <sandbox> -m <model> -",
      "prompt_transport": "stdin",
      "discovery": null
    },
    {
      "id": "claude",
      "display_name": "Claude Code CLI",
      "kind": "cli",
      "binary": "claude",
      "family": "anthropic",
      "roles": ["reviewer"],
      "headless": "claude -p --model <model> --output-format json",
      "prompt_transport": "stdin",
      "discovery": null
    },
    {
      "id": "agy",
      "display_name": "AGY CLI (Antigravity)",
      "kind": "cli",
      "binary": "agy",
      "family": "google",
      "roles": ["scout"],
      "headless": "agy --print=<prompt> --model <model> --sandbox --mode plan",
      "prompt_transport": "argv",
      "discovery": {"kind": "cli", "argv": ["agy", "models"], "format": "tsv"}
    },
    {
      "id": "gosling",
      "display_name": "Gosling",
      "kind": "cli",
      "binary": "gosling",
      "family": "local",
      "roles": ["editor"],
      "headless": "gosling --model <model>",
      "prompt_transport": "stdin",
      "discovery": null
    },
    {
      "id": "grok",
      "display_name": "Grok CLI",
      "kind": "cli",
      "binary": "grok",
      "family": "xai",
      "roles": ["editor", "reviewer", "scout"],
      "headless": "grok --prompt-file /dev/stdin --cwd <dir> --model <model> --output-format json",
      "prompt_transport": "prompt-file-stdin",
      "prompt_transport_note": "Grok CLI 1.0.13 reads a prompt file in headless mode. Unix and macOS pass /dev/stdin so the prompt is never visible in the process argument list; Windows has no /dev/stdin and retains the bounded positional --single path.",
      "discovery": {"kind": "cli", "argv": ["grok", "models"], "format": "grok-list"}
    },
    {
      "id": "openai-compatible",
      "display_name": "OpenAI-compatible endpoint",
      "kind": "http",
      "binary": null,
      "family": "local",
      "roles": ["reviewer", "scout"],
      "headless": "POST <base_url>/chat/completions",
      "prompt_transport": "http",
      "discovery": null
    },
    {
      "id": "mistral-acp",
      "display_name": "Mistral Vibe (ACP)",
      "kind": "acp",
      "binary": "vibe-acp",
      "family": "mistral",
      "roles": ["reviewer", "scout"],
      "headless": "vibe-acp (Agent Client Protocol over stdio)",
      "prompt_transport": "acp",
      "discovery": {"kind": "acp", "config_option": "model"},
      "discovery_note": "Current Vibe builds advertise model choices as a session configuration option in the session/new result. Selection goes through session/set_config_option with configId \"model\"; the obsolete session/set_model method must not be used."
    }
  ],
